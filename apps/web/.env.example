# Public Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Preferred: Supabase publishable key. A legacy anon key is accepted as fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Never add SUPABASE_SERVICE_ROLE_KEY or any secret key to this file.
# The web application must use the user's session and server-side authorization.